```groovy
pipeline {
    agent any

    parameters {
        choice(name: 'ENV', choices: ['dev', 'test', 'prod'], description: 'Select environment')
        string(name: 'APP_NAME', defaultValue: 'HelloWorld', description: 'Enter application name')
    }

    environment {
        VERSION = '1.0'
    }

    stages {

        stage('Checkout') {
            steps {
                echo "Checking out source code..."
            }
        }

        stage('Build') {
            steps {
                echo "Building ${params.APP_NAME}..."
            }
        }

        stage('Test') {
            steps {
                echo "Running tests..."
            }
        }

        stage('Package') {
            steps {
                echo "Creating package..."
            }
        }

        stage('Deploy') {
            steps {
                input message: "Deploy ${params.APP_NAME} to ${params.ENV}?", ok: 'Deploy'
                echo "Deploying application..."
            }
        }

        stage('Verify') {
            steps {
                echo "Verifying deployment..."
            }
        }
    }

    post {

        always {
            echo "Always: Pipeline finished"
        }

        success {
            echo "Success: Deployment completed successfully"
        }

        failure {
            echo "Failure: Pipeline failed"
        }

        unstable {
            echo "Unstable: Check test results"
        }

        changed {
            echo "Changed: Build status changed"
        }

        aborted {
            echo "Aborted: Pipeline was stopped"
        }

        cleanup {
            echo "Cleanup: Removing temporary files"
        }
    }
}
