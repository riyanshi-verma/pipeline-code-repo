pipeline {
    agent any

    parameters {
        choice(name: 'REGION', choices: ['Mumbai', 'Delhi', 'Bangalore'], description: 'Select deployment region')
        booleanParam(name: 'RUN_TESTS', defaultValue: true, description: 'Run tests?')
        string(name: 'VERSION', defaultValue: '2.0', description: 'Enter application version')
    }

    environment {
        APP_ENV = 'staging'
        OWNER = 'Jenkins'
    }

    stages {

        stage('Prepare') {
            steps {
                echo "Preparing deployment..."
                echo "Application version: ${params.VERSION}"
            }
        }

        stage('Compile') {
            steps {
                echo "Compiling application..."
            }
        }

        stage('Test') {
            when {
                expression {
                    params.RUN_TESTS
                }
            }
            steps {
                echo "Running application tests..."
            }
        }

        stage('Create Artifact') {
            steps {
                echo "Creating deployment artifact..."
            }
        }

        stage('Approval') {
            steps {
                input message: "Deploy version ${params.VERSION} to ${params.REGION}?", ok: 'Approve'
            }
        }

        stage('Deploy') {
            steps {
                echo "Deploying application to ${params.REGION}..."
                echo "Environment: ${env.APP_ENV}"
                echo "Owner: ${env.OWNER}"
            }
        }

        stage('Health Check') {
            steps {
                echo "Checking application health..."
            }
        }
    }

    post {

        always {
            echo "Pipeline execution completed"
        }

        success {
            echo "Deployment successful"
        }

        failure {
            echo "Deployment failed"
        }

        unstable {
            echo "Deployment completed with warnings"
        }

        changed {
            echo "Build status has changed"
        }

        aborted {
            echo "Deployment was aborted"
        }

        cleanup {
            echo "Performing final cleanup"
        }
    }
}
